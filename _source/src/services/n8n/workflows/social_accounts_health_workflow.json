{
  "name": "AuraSocial — Social Accounts Health",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger (Every 6h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{$env.AURASOCIAL_API_URL || 'https://api.aurasocial.app'}}/api/social/providers/health",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.AURASOCIAL_N8N_API_KEY}}"
            },
            {
              "name": "x-workspace-id",
              "value": "={{$env.DEFAULT_WORKSPACE_ID}}"
            }
          ]
        },
        "options": {}
      },
      "id": "get-providers-health",
      "name": "Check Providers Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "url": "={{$env.AURASOCIAL_API_URL || 'https://api.aurasocial.app'}}/api/social/accounts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.AURASOCIAL_N8N_API_KEY}}"
            },
            {
              "name": "x-workspace-id",
              "value": "={{$env.DEFAULT_WORKSPACE_ID}}"
            }
          ]
        },
        "options": {}
      },
      "id": "get-accounts",
      "name": "Fetch Social Accounts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.data.bound.length > 0}}",
              "value2": true
            }
          ]
        }
      },
      "id": "has-accounts-check",
      "name": "Has Accounts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [920, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AURASOCIAL_API_URL || 'https://api.aurasocial.app'}}/api/social/accounts/{{$json.id}}/health-check",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.AURASOCIAL_N8N_API_KEY}}"
            },
            {
              "name": "x-workspace-id",
              "value": "={{$env.DEFAULT_WORKSPACE_ID}}"
            }
          ]
        },
        "options": {}
      },
      "id": "run-account-health",
      "name": "Run Account Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1150, 240]
    }
  ],
  "connections": {
    "Schedule Trigger (Every 6h)": {
      "main": [
        [
          {
            "node": "Check Providers Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Providers Health": {
      "main": [
        [
          {
            "node": "Fetch Social Accounts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Social Accounts": {
      "main": [
        [
          {
            "node": "Has Accounts?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Accounts?": {
      "main": [
        [
          {
            "node": "Run Account Health Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
