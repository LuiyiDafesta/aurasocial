# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Timezone de Negocio
VITE_APP_TIMEZONE=America/Argentina/Buenos_Aires

# Backblaze B2 Storage Configuration (S3 Compatible)
VITE_B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
VITE_B2_REGION=us-west-004
VITE_B2_BUCKET_NAME=AuraSocial
VITE_B2_BUCKET_ID=32895a1118da28beac0e081c
VITE_B2_KEY_ID=your-b2-key-id
VITE_B2_APPLICATION_KEY=your-b2-application-key

# ==============================================================================
# Social Providers Layer Configuration (Socialit PRIMARY, Robin Research SECONDARY)
# SERVER-SIDE ONLY (Edge Functions / Backend) - NEVER use VITE_ prefix for secrets!
# ==============================================================================
SOCIAL_PROVIDER_PRIMARY=socialit
SOCIAL_PROVIDER_SECONDARY=robin_research

# 🥇 Socialit Configuration (Primary Provider)
SOCIALIT_API_KEY=your-socialit-api-key
SOCIALIT_API_URL=https://api.socialit.com
SOCIALIT_CLIENT_ID=your-socialit-client-id

# 🥈 Robin Research Configuration (Secondary / Fallback Provider)
ROBIN_RESEARCH_API_KEY=your-robin-research-api-key
ROBIN_RESEARCH_API_URL=https://api.robinresearch.io/v1

# 🔌 Meta Direct Legacy/Optional Configuration
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_CLIENT_ID=your-meta-app-id
META_CLIENT_SECRET=your-meta-app-secret
META_REDIRECT_URI=https://your-domain.com/oauth/callback

# Other Direct Providers (Server-Side ONLY)
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
